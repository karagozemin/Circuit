# Public read endpoints. The defaults in src/lib/dreamdex/config.ts work without this file.
VITE_SOMNIA_RPC_URL=https://api.infra.testnet.somnia.network
VITE_SOMNIA_FALLBACK_RPC_URL=https://dream-rpc.somnia.network
VITE_SOMNIA_DIAGNOSTIC_RPC_URL=https://rpc.ankr.com/somnia_testnet
VITE_SOMNIA_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
VITE_DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# Public deployment addresses used by the browser activation flow.
# VITE_CIRCUIT_ENGINE_ADDRESS=0x...
# VITE_CIRCUIT_HANDLER_ADDRESS=0x...

# Server/CLI only. Never expose this as a VITE_* variable or commit it.
# CIRCUIT_OPERATOR_PRIVATE_KEY=0x...
# CIRCUIT_OWNER_ADDRESS=0x...
# CIRCUIT_ENGINE_ADDRESS=0x...
# CIRCUIT_HANDLER_ADDRESS=0x...
# CIRCUIT_SUBSCRIPTION_ID=...
# CIRCUIT_DIAGNOSTIC_RPC_URL=https://rpc.ankr.com/somnia_testnet
